# Copy this file to .env and fill in personal values. Never commit .env.

# ACLED —> register a free account at https://acleddata.com/user/register
# Use institutional/university email for broader access if in possession.
ACLED_EMAIL=you@example.com
ACLED_PASSWORD=your_acled_password

# NASA FIRMS —> request a free MAP_KEY at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key
